Window.SetBackgroundTopColor(0.02, 0.04, 0.09);
Window.SetBackgroundBottomColor(0.03, 0.08, 0.16);

title_image = Image.Text("NizamOS 1.0", 0.38, 0.80, 1.0, 1.0, "Sans Bold 28");
title_sprite = Sprite(title_image);
title_sprite.SetPosition(
  Window.GetWidth() / 2 - title_image.GetWidth() / 2,
  Window.GetHeight() / 2 - 28,
  10
);

subtitle_image = Image.Text("Starting desktop environment...", 0.72, 0.78, 0.86, 0.85, "Sans 12");
subtitle_sprite = Sprite(subtitle_image);
subtitle_sprite.SetPosition(
  Window.GetWidth() / 2 - subtitle_image.GetWidth() / 2,
  Window.GetHeight() / 2 + 18,
  10
);
